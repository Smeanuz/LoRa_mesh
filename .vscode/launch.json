{
  // Debug Wio-E5 mini (STM32WLE5JC) bằng J-Link + Cortex-Debug
  // Đường dẫn tool lấy từ biến môi trường của từng máy (xem README / DEV_SETUP):
  //   ZEPHYR_SDK_INSTALL_DIR, JLINK_DIR
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Wio-E5 (J-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "serverpath": "${env:JLINK_DIR}/JLinkGDBServerCL.exe",
      "device": "STM32WLE5JC",
      "interface": "swd",
      "serverArgs": ["-speed", "1000"],
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb.exe",
      "rtos": "Zephyr",
      "runToEntryPoint": "main",
      "preLaunchTask": "west build (debug)",
      "showDevDebugOutput": "none"
      // "svdFile": "${workspaceFolder}/.vscode/STM32WLE5_CM4.svd"
    },
    {
      "name": "Attach Wio-E5 (J-Link, không reset)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "jlink",
      "serverpath": "${env:JLINK_DIR}/JLinkGDBServerCL.exe",
      "device": "STM32WLE5JC",
      "interface": "swd",
      "serverArgs": ["-speed", "1000"],
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb.exe",
      "rtos": "Zephyr"
      // "svdFile": "${workspaceFolder}/.vscode/STM32WLE5_CM4.svd"
    }
  ]
}
